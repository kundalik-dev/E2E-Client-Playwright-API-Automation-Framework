{
  "name": "E2E-Client-Playwright-API-Automation-Framework",
  "version": "1.0.0",
  "description": "E2E automation framework for Playwright and API testing with javascript. ",
  "main": "index.js",
  "scripts": {
    "test": "cross-env ENV=local playwright test",
    "test:local": "cross-env ENV=local playwright test",
    "test:qa": "cross-env ENV=qa playwright test",
    "test:prod": "cross-env ENV=prod playwright test",
    "test:headed": "cross-env ENV=local playwright test --headed",
    "test:debug": "cross-env ENV=local playwright test --debug",
    "test:report": "playwright show-report",
    "test:report:open": "playwright show-report --open",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.21.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "cross-env": "^10.1.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
